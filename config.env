# KernelSU Action -- build profile
# Target: Redmi K50 Pro (matisse / MediaTek MT6983)
# Stage B0: plain kernel build, no root, no SUSFS. Only goal = does it boot.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/xiaomi-mt6983-devs/android_kernel_xiaomi_mt6983
KERNEL_SOURCE_BRANCH=WIP/lineage-23.0-5.10.264
KERNEL_CONFIG=vendor/matisse_gki_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Leave blank so CONFIG_LOCALVERSION is untouched. Changing it would alter
# the kernel release string and break vendor module vermagic matching.
KERNEL_NAME=

ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error
CUSTOM_CMDS:

# =================================================================== Clang ==
#
# 5.10 trees need a newer clang than the 4.x default. r547379 is the verified
# pair for main-kernel-2025. If it fails with dropped flags, fall back to
# CLANG_BRANCH=master-kernel-build-2022 / CLANG_VERSION=r450784e.
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# LLVM=1 LLVM_IAS=1 -- required for modern 5.10+ trees.
USE_LLVM=true

# ===================================================================== GCC ==
#
# Not needed when USE_LLVM=true.
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
#
# B0 uses none. Once this boots, switch to:
#   KSU_VARIANT=sukisu-ultra
#   KSU_REF=builtin          <- ships SUSFS itself
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
#
# B0 off. B2 turns this on with SUSFS_BRANCH=gki-android12-5.10.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=true
DISABLE_CC_WERROR=true

- EXTRA_DEFCONFIG=CONFIG_MTK_UART_APDMA=n
+ EXTRA_DEFCONFIG=CONFIG_MTK_UART_APDMA=n CONFIG_WERROR=n


# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
#
# Keep false: we repack boot.img locally with the verified byte-level logic,
# which avoids depending on a public direct link to the stock boot image.
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
